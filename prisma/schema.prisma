generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  USER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  fullName  String
  phone     String
  region    String
  city      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  bookings  Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  service   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
